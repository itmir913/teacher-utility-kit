# ────────────────────────────────────────────────────────
# relay 모드 환경변수 (로컬 단독 운영 또는 Cloud VPS 배포 시 사용.)
# 실행: docker compose --env-file .env.relay up -d
# ────────────────────────────────────────────────────────

MODE=relay
NODE_OPTIONS=--max-old-space-size=512

# 접속을 허용할 외부 도메인 (쉼표 구분)
ALLOWED_ORIGINS=https://luminousky.com,https://www.luminousky.com

# relay 모드에서는 사용하지 않음
CLOUD_URL=
