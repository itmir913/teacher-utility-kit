# ────────────────────────────────────────────────────────
# mirror 모드 환경변수 (내부망과 외부망을 동시에 지원해야 할 때 사용)
# 실행: docker compose --env-file .env.mirror --profile mirror up -d
# ────────────────────────────────────────────────────────

MODE=mirror
NODE_OPTIONS=--max-old-space-size=512

# 접속을 허용할 외부 도메인 (쉼표 구분)
ALLOWED_ORIGINS=

# 신호를 복제할 외부 relay 서버 주소 (필수)
# ▼ 외부 relay 서버 주소로 변경하세요
CLOUD_URL=https://your-cloud-domain.com

# ── Server-to-Server Authentication Key ──
# 해당 키가 일치하는 Mirror 서버는 도메인(Origin) 검증을 우회하여 Relay 서버와 연동됩니다.
MIRROR_SECRET_KEY=super_secret_password_123!
